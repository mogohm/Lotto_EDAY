# ---- copy to .env (never commit .env) ----
# Feature flags (real-money flags are hard-locked to false in the API regardless of these values)
DEMO_MODE=true
LIVE_PURCHASE_ENABLED=false
PAYMENT_ENABLED=false
PRIZE_SETTLEMENT_ENABLED=false
OFFICIAL_FEED_ENABLED=false

# API secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Password for the seeded staff accounts (superadmin/admin/editor/reviewer/auditor@lottoday.demo)
SEED_STAFF_PASSWORD=Admin@1234
POSTGRES_PASSWORD=localpass
# Comma-separated browser origins allowed to call the API cross-origin (not needed when same-origin)
CORS_ORIGINS=http://localhost:8080
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT=5
