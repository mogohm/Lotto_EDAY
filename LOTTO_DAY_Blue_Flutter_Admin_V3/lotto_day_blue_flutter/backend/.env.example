# Local API (npm run dev / npm start). For the zero-Docker path use: npm run build && npm run dev:embedded
DATABASE_URL="postgresql://lotto:localpass@localhost:5432/lotto_day_demo?schema=public"
NODE_ENV=development
PORT=3000
JWT_SECRET=dev-only-change-me-0123456789abcdefghijklmnop
SEED_STAFF_PASSWORD=Admin@1234
CORS_ORIGINS=http://localhost:8080,http://localhost:5000
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT=5
# REAL_MONEY_AUTHORIZED must stay unset: no payment provider exists in this build.
