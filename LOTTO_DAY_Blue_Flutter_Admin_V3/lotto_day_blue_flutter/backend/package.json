{
  "name": "lotto-day-demo-api",
  "version": "0.4.0",
  "private": true,
  "description": "LOTTO DAY V3 demo API (NestJS + Prisma + PostgreSQL). Real-money features are permanently disabled.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "prisma migrate deploy && node dist/seed.js && node dist/main.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:e2e": "jest --config jest.config.js --selectProjects e2e --runInBand",
    "dev:embedded": "node scripts/dev-embedded.mjs",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "17.12.0-beta.19",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.12.0-beta.19": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@nestjs/core": false
  },
  "prisma": {
    "seed": "ts-node src/seed.ts"
  }
}
