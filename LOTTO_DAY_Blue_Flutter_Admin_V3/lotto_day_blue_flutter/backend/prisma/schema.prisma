// LOTTO DAY V3 — demo schema. Monetary values are SIMULATED demo credits only.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RESULT_EDITOR
  REVIEWER
  AUDITOR
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum LotteryKind {
  DAILY
  LAO
  VIETNAM
  THAI
}

/// SCHEDULED -> DRAFT -> AWAITING_REVIEW -> APPROVED -> PUBLISHED; CANCELLED from any non-published state.
enum DrawStatus {
  SCHEDULED
  DRAFT
  AWAITING_REVIEW
  APPROVED
  PUBLISHED
  CANCELLED
}

enum ResultSource {
  INTERNAL_DEMO
  EXTERNAL_UNVERIFIED
  OFFICIAL_VERIFIED
}

enum TicketStatus {
  AVAILABLE
  SOLD
  WITHDRAWN
}

enum OrderStatus {
  CONFIRMED_DEMO
  CANCELLED
}

enum WalletTxType {
  TOPUP_DEMO
  WITHDRAW_DEMO
  PURCHASE_DEMO
  REFUND_DEMO
  ADJUSTMENT_DEMO
}

enum WalletTxStatus {
  SUCCESS
  PENDING
  REJECTED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?
  passwordHash String
  displayName  String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  kycStatus    KycStatus  @default(NONE)
  /// Simulated, non-redeemable demo credits (THB-denominated for display only).
  demoBalance  Int        @default(0)
  tokenVersion Int        @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  cartItems     CartItem[]
  orders        Order[]
  walletTxs     WalletTransaction[]
  notifications Notification[]

  @@index([role, status])
  @@index([createdAt])
}

model LotteryMarket {
  id               String       @id
  nameTh           String
  nameEn           String       @default("")
  kind             LotteryKind
  description      String       @default("")
  allowedDigits    Int[]
  allowedPositions String[]
  source           ResultSource
  enabled          Boolean      @default(true)
  timezone         String       @default("Asia/Bangkok")
  /// HH:mm local time in `timezone`
  openTime         String       @default("06:00")
  closeTime        String       @default("15:30")
  resultTime       String       @default("16:00")
  /// 0=Sunday..6=Saturday
  drawWeekdays     Int[]        @default([0, 1, 2, 3, 4, 5, 6])
  ticketPrice      Int          @default(80)
  sortOrder        Int          @default(0)
  version          Int          @default(1)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  draws            LotteryDraw[]
}

model LotteryDraw {
  id               String        @id @default(uuid())
  marketId         String
  market           LotteryMarket @relation(fields: [marketId], references: [id])
  drawDate         DateTime      @db.Date
  opensAt          DateTime?
  closesAt         DateTime?
  status           DrawStatus    @default(SCHEDULED)
  results          Json          @default("{}")
  sourceNote       String        @default("")
  sourceName       String?
  sourceUrl        String?
  sourceCapturedAt DateTime?
  sourceVerified   Boolean       @default(false)
  createdById      String?
  editedById       String?
  submittedById    String?
  submittedAt      DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  approvedBy       String?
  publishedById    String?
  publishedAt      DateTime?
  cancelReason     String?
  version          Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tickets          DemoTicket[]

  @@unique([marketId, drawDate])
  @@index([marketId, status, drawDate])
  @@index([status])
}

model DemoTicket {
  id        String       @id @default(uuid())
  drawId    String
  draw      LotteryDraw  @relation(fields: [drawId], references: [id])
  number    String
  set       Int          @default(1)
  price     Int
  status    TicketStatus @default(AVAILABLE)
  createdAt DateTime     @default(now())
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([drawId, number, set])
  @@index([drawId, status])
}

model CartItem {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId  String
  ticket    DemoTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, ticketId])
}

model Order {
  id         String      @id @default(uuid())
  receiptNo  String      @unique
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  total      Int
  status     OrderStatus @default(CONFIRMED_DEMO)
  cancelNote String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id       String     @id @default(uuid())
  orderId  String
  order    Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketId String
  ticket   DemoTicket @relation(fields: [ticketId], references: [id])
  number   String
  drawId   String
  price    Int

  @@index([ticketId])
  @@index([drawId])
}

model WalletTransaction {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  type         WalletTxType
  status       WalletTxStatus @default(SUCCESS)
  amount       Int
  balanceAfter Int
  reference    String?
  note         String         @default("")
  createdAt    DateTime       @default(now())

  @@index([userId, createdAt])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  body        String
  category    String    @default("NEWS")
  pinned      Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// Append-only, hash-chained audit trail. Never update or delete rows.
model AuditEvent {
  id         String   @id @default(uuid())
  seq        Int      @default(autoincrement())
  actor      String
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  prevHash   String   @default("")
  hash       String   @default("")
  timestamp  DateTime @default(now())

  @@unique([seq])
  @@index([entityType, entityId, timestamp])
  @@index([action, timestamp])
  @@index([actorId, timestamp])
}
